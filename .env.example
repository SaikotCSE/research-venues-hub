# Copy to .env and adjust. Real environment variables always win over this file.

# --- Core -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required when serving over HTTPS on a custom domain, e.g. https://venuepulse.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
# Move the admin away from /admin/ in production
DJANGO_ADMIN_URL=admin/

# --- Data stores ----------------------------------------------------------------
# Defaults to SQLite (db.sqlite3). Example: postgres://user:pass@localhost:5432/venuepulse
DATABASE_URL=
# Optional cache backend; defaults to per-process memory
REDIS_URL=

# --- Email --------------------------------------------------------------------------
# Required in production: sign-up and password reset email a one-time code. Pick ONE option
# (see docs/DEPLOYMENT.md#email). With neither set, emails are only printed to the console.
#
# Option A: Brevo's HTTPS API. Use this on hosts that block SMTP, such as Render's free plan.
# Create an API key under SMTP & API → API keys, and verify DJANGO_FROM_EMAIL under Senders.
BREVO_API_KEY=
#
# Option B: SMTP, e.g. Gmail with an app password (needs 2-Step Verification on the account).
# Only works where outbound port 587 is open (Render: paid instances only).
#   EMAIL_HOST=smtp.gmail.com  EMAIL_HOST_USER=you@gmail.com  EMAIL_HOST_PASSWORD=<16-char app password, no spaces>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DJANGO_FROM_EMAIL=VenuePulse <noreply@example.com>

# --- Security (production settings) -------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_HSTS_SECONDS=31536000
CSP_REPORT_ONLY=0
RATELIMIT_ENABLED=1
# Set to 1 only behind a proxy that overwrites X-Forwarded-For
RATELIMIT_USE_X_FORWARDED_FOR=0

# --- Local docker compose over plain HTTP (never in real production) --------------
# DJANGO_SECURE_SSL_REDIRECT=0
# DJANGO_SECURE_COOKIES=0
# DJANGO_SECURE_HSTS_SECONDS=0

LOG_LEVEL=INFO
